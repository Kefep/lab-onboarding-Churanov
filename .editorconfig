# Это корневой файл настроек для всего проекта
root = true

# Правила для всех файлов (*)
[*]
# Использовать кодировку UTF-8
charset = utf-8
# Использовать пробелы для отступов
indent_style = space
# Размер оступа : 4 пробела
indent_size = 4
# Тип переноса строки: Lf (стандарт для Linux/macOS Git)
end_of_line = lf
# Удалять лишние побелы в конце строк
trim_trailing_whitespace = true
# Добавлять пустую строку в конец файла
insert_final_newline = true

# Особые правила для файлов разметки
[*.{yml,yaml,json,html}]
indent_size = 2
